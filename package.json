{
  "name": "cropper",
  "productName": "Cropper",
  "version": "1.0.0",
  "description": "Кроп и коллажи для Instagram-каруселей",
  "main": "main.js",
  "author": "phantemasta",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "fonts": "node scripts/copy-fonts.js",
    "dist": "npm run fonts && node scripts/make-icon.js && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.phantemasta.cropper",
    "productName": "Cropper",
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cropper"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
